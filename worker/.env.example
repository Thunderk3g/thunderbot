# Copy to worker/.env on your machine, or /etc/thunderbot.env on a VPS (chmod 600). Never commit real values.

# Keys saved from the dashboard's Setup screen (the LLM key and the Groww login) are stored encrypted and
# read by the worker at the start of each pass. They win over the LLM_* / ANTHROPIC_API_KEY / GROWW_* values
# below, which keep working when nothing is saved. Both sides must derive the same encryption key: set the
# same TB_SECRET_KEY here and on the dashboard (for example `openssl rand -hex 32`). When it is unset, the
# database key both already hold is used (SUPABASE_SERVICE_ROLE_KEY, or TB_LOCAL_API_KEY with `thunderbot serve`),
# so rotating that key means saving the keys again. Nothing saved in the dashboard can enable live trading.
# TB_SECRET_KEY=

# Groww Trade API (TOTP flow recommended; or set GROWW_API_SECRET for the daily-approval flow)
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# GROWW_API_SECRET=

# Compliance: the static IP(s) whitelisted on groww.in/trade-api/api-keys (primary[,secondary])
TB_EXPECTED_STATIC_IP=
# Live trading is refused unless this is true AND `thunderbot live --i-understand-the-risks` is used
TB_LIVE_TRADING_ENABLED=false
# Require a human to confirm each day's broker login (dashboard button or `thunderbot confirm-login`)
TB_REQUIRE_LOGIN_CONFIRMATION=true
# MTF via API is unverified on Groww; keep false until confirmed with Groww support on a live account
TB_ALLOW_MTF_API=false

# Strategy: orb | vwap_reversion | ema_pullback | momentum | ai (the dashboard can switch it at runtime)
TB_STRATEGY=orb

# Capital and hard risk limits
TB_CAPITAL=100000
TB_RISK_PER_TRADE_PCT=0.5
TB_MAX_DAILY_LOSS_PCT=2
TB_MAX_OPEN_POSITIONS=3
TB_MAX_TRADES_PER_DAY=6
TB_MAX_LEVERAGE=1
TB_MAX_POSITION_NOTIONAL_PCT=50
TB_MAX_STOP_DISTANCE_PCT=3
TB_ALLOW_SHORT=true

# Universe and timing (IST)
TB_SYMBOLS=RELIANCE,HDFCBANK,INFY,ICICIBANK,TCS
TB_INTERVAL_MINUTES=5
TB_ENTRY_START=09:30
TB_ENTRY_END=14:30
TB_FLATTEN_AT=15:05
# Defaults to the list shipped with the package (thunderbot/universes/nse_holidays.txt); update it each December.
# TB_HOLIDAYS_FILE=/opt/thunderbot/worker/deploy/nse_holidays.txt
TB_POLL_SECONDS=10

# Execution (orders/sec is hard-capped at 9, below SEBI's 10 OPS threshold)
TB_ORDERS_PER_SECOND=5
TB_ORDERS_PER_MINUTE=200
TB_PRICE_PROTECTION_PCT=0.5
TB_STOP_LIMIT_BUFFER_PCT=0.5
TB_SLIPPAGE_BPS=5

# LLM review layer. For intraday signals it can veto or shrink, never enlarge or create one.
# For daily rebalances it can postpone one session (twice at most), never change an order.
# The easy way is the dashboard's Setup screen: pick a provider, paste a key, choose a model. A key saved
# there turns the LLM on; TB_LLM_ENABLED=false here switches every LLM role off whatever key is present.
# The values below are the environment route, for Claude through Anthropic's API.
TB_LLM_ENABLED=false
ANTHROPIC_API_KEY=
TB_LLM_MODEL=claude-opus-5-5
TB_LLM_EFFORT=medium
TB_LLM_FAIL_MODE=reject
TB_LLM_MIN_CONFIDENCE=0.5

# AI desk (intraday): setups scored by a trained model, then taken or skipped by an LLM. See docs/ai-desk.md.
# Any OpenAI-compatible chat endpoint (xAI Grok, Groq, OpenAI, Gemini, OpenRouter, a local server). With all
# three set the LLM is on unless TB_LLM_ENABLED=false, and the same endpoint reviews daily rebalances.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=
# The stocks the desk watches (default: 24 liquid Nifty 50 names).
# TB_AI_SYMBOLS=RELIANCE,HDFCBANK,ICICIBANK
# To trade the AI strategy through the engine (thunderbot paper / live), set TB_STRATEGY=ai above.

# Persistence
# Daily investing (`thunderbot invest`, `thunderbot tick`, and the serverless worker):
#   core_mix (default)  NIFTYBEES + JUNIORBEES + GOLDBEES in fixed shares, rebalanced each March
#   etf_trend           the same ETFs, each held only above its 200-day average; the rest in a liquid ETF
#   etf_rank            the strongest ETFs by 3/6/12-month return that also beat the liquid ETF
#   index_trend         NIFTYBEES above the Nifty's 200-day average, else the liquid ETF
#   momentum            top Nifty 100 stocks, quarterly (its backtest is biased; see the report)
# The dashboard's Lab can switch strategy and parameters at runtime.
TB_INVEST_STRATEGY=core_mix
# IST time of the daily decision; the live price then stands in for the closing price.
TB_INVEST_AT=15:10
# A live run that starts after this does not trade; it decides again the next trading day.
TB_INVEST_CUTOFF=15:25
# The growth-type liquid ETF that idle money is parked in.
TB_LIQUID_SYMBOL=LIQUIDCASE
# Your marginal income-tax rate, %: used for liquid ETF gains and gold ETFs sold within 12 months.
TB_SLAB_RATE_PCT=30

# Alerts to your phone (optional): a rebalance was made, a run was missed, prices looked wrong.
# TB_NTFY_TOPIC=a-long-topic-name-nobody-can-guess
# TB_TELEGRAM_TOKEN=
# TB_TELEGRAM_CHAT_ID=

# Serverless worker only: the secret schedulers send as "Authorization: Bearer ...".
# CRON_SECRET=

# Price feed for paper trading: groww (official; needs the paid Live Data plan) or yahoo (free; can lag)
TB_FEED=yahoo

TB_DATA_DIR=/var/lib/thunderbot
# CSV candles for dashboard backtests with data source "CSV" (fill with `thunderbot fetch-history`)
TB_BACKTEST_DATA_DIR=/opt/thunderbot/worker/data/groww
# Local mode only: key for `thunderbot serve` (the dashboard uses it as SUPABASE_SERVICE_ROLE_KEY)
# TB_LOCAL_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily investing: how far a holding may drift from its target before anything is sold. A holding is out
# of its corridor when it is this many percentage points, or this share of its target, away (whichever
# is tighter).
# TB_BAND_ABS_PCT=5
# TB_BAND_REL_PCT=20
# How a tax-year harvest gets the money back in: t_plus_1 (sell, rebuy next session) or twin (swap into
# a twin ETF the same day). A same-day sale and rebuy of one fund books nothing.
# TB_HARVEST_VIA=t_plus_1
# An edited copy of the harness (docs/harness.md). Unset uses the one shipped with the worker.
# TB_HARNESS_DIR=/opt/thunderbot/harness
