# Server-side only. Never prefix these with NEXT_PUBLIC_.
#
# Production: your Supabase project URL and service-role key.
# Local, no cloud: run `thunderbot serve` in worker/ and use
#   SUPABASE_URL=http://127.0.0.1:8787
#   SUPABASE_SERVICE_ROLE_KEY=<the TB_LOCAL_API_KEY it prints>
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# HTTP Basic Auth for the whole dashboard. If unset, every request is refused.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
