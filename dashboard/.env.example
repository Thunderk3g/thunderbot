# Server-side only. Never prefix these with NEXT_PUBLIC_.
#
# Production: your Supabase project URL and service-role key.
# Local, no cloud: run `thunderbot serve` in worker/ and use
#   SUPABASE_URL=http://127.0.0.1:8787
#   SUPABASE_SERVICE_ROLE_KEY=<the TB_LOCAL_API_KEY it prints>
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# HTTP Basic Auth for the whole dashboard. If unset, every request is refused.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Keys saved on the Setup screen (your LLM key, your Groww login) are encrypted with this before they are
# stored, and the worker decrypts them with the same value, so set it here and wherever the worker runs.
# Any long random string, for example `openssl rand -hex 32`. When unset, SUPABASE_SERVICE_ROLE_KEY is used,
# which works as long as that key is never rotated.
# TB_SECRET_KEY=

# The worker function (api/worker.py) on Vercel. Schedulers send this as "Authorization: Bearer ...";
# store the same value in Supabase Vault as thunderbot_cron_secret. See docs/no-server.md.
CRON_SECRET=
# Paper capital and strategy for the worker function (optional; these are the defaults).
TB_CAPITAL=100000
TB_INVEST_STRATEGY=core_mix
TB_LIQUID_SYMBOL=LIQUIDCASE
TB_SLAB_RATE_PCT=30
# Optional phone alerts.
# TB_NTFY_TOPIC=
# The LLM is easiest to connect on the Setup screen. The environment route still works:
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL for any OpenAI-compatible endpoint, or
# TB_LLM_ENABLED=true with ANTHROPIC_API_KEY for Claude. TB_LLM_ENABLED=false switches the LLM off.
