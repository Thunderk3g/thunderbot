{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "api/worker.py": { "maxDuration": 300 }
  },
  "schedules": {
    "thunderbot-market-tick": {
      "schedule": "*/15 9-15 * * 1-5",
      "timezone": "Asia/Kolkata",
      "path": "/api/worker",
      "requestMethod": "GET"
    }
  },
  "crons": [
    { "path": "/api/worker", "schedule": "40 9 * * 1-5" }
  ]
}
